# 厂商接口连通巡检库 — 环境变量模板
#
# 复制本文件到 .env 后填写真实值；生产环境通过 systemd EnvironmentFile 或 K8s Secret 注入，
# 切勿把真实凭据提交到 git。vendor_if_doctor 仅在缺失 secret_env 时启动期 fail-fast，
# 不会自动 fallback 到明文 / 占位 / 内嵌 default。
#
# 通用：
#   VENDOR_DOCTOR_HANDOVER_DIR=out    # 值班交接 Markdown 输出目录
#   VENDOR_DOCTOR_TICKETS_DIR=out     # 工单草稿 JSONL 输出目录
#   VENDOR_DOCTOR_DB=vendor_if_doctor.db   # SQLite 巡检历史文件
#   VENDOR_DOCTOR_LOG_LEVEL=INFO          # 日志级别（DEBUG/INFO/WARNING/ERROR）
#   VENDOR_DOCTOR_PLUGINS=               # 逗号分隔的 Python 模块列表，启动期 import + register_protocol
#
# 凭据别名（auth.secret_env）一律遵守 VENDOR_<NAME>_<KIND> 命名：
#   KIND ∈ { HOST, USERNAME, PASSWORD, TOKEN, AUTH_TOKEN, APIKEY, MTLS_CERT, MTLS_KEY, MTLS_CA }
#   _AUTH_TOKEN 与 _TOKEN 互为 alias（同时设置时 _AUTH_TOKEN 优先并 warning）
#
# ─── HIS 厂商 ───
VENDOR_HIS_HOST=his-gateway.example.cn
VENDOR_HIS_USERNAME=his_user
VENDOR_HIS_PASSWORD=change_me
# bearer 时设 VENDOR_HIS_AUTH_TOKEN=/VENDOR_HIS_TOKEN（同义）
# VENDOR_HIS_AUTH_TOKEN=
#
# ─── LIS 厂商 ───
VENDOR_LIS_HOST=lis-gateway.example.cn
VENDOR_LIS_AUTH_TOKEN=change_me
#
# ─── PACS 厂商 ───
VENDOR_PACS_HOST=pacs-gateway.example.cn
VENDOR_PACS_APIKEY=change_me
#
# ─── EMR 厂商（HL7v2 / MLLP）───
VENDOR_EMR_HOST=emr-mllp.example.cn
VENDOR_EMR_PORT=6661
VENDOR_EMR_AUTH_TOKEN=change_me
#
# ─── 医保接口（占位 webservice）───
VENDOR_MEDICAL_INSURANCE_HOST=mi-gateway.example.cn
VENDOR_MEDICAL_INSURANCE_AUTH_TOKEN=change_me
#
# ─── 区域平台（占位 sql）───
VENDOR_REGIONAL_HOST=db-regional.example.cn
VENDOR_REGIONAL_USERNAME=readonly_user
VENDOR_REGIONAL_PASSWORD=change_me
